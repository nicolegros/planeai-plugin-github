{
  "schema": "planeai.plugin.v1",
  "id": "github",
  "name": "GitHub",
  "version": "0.0.0",
  "host_api_version": "planeai.plugin-host.v8",
  "source_kind": "local",
  "backend_entrypoints": {
    "macos-arm64": "bin/macos-arm64/planeai-plugin-github",
    "macos-x64": "bin/macos-x64/planeai-plugin-github",
    "linux-x64": "bin/linux-x64/planeai-plugin-github",
    "windows-x64": "bin/windows-x64/planeai-plugin-github.exe"
  },
  "capabilities": [
    "settings",
    "sessions.read",
    "sessions.repository-context",
    "sessions.prompt",
    "tasks.read",
    "tasks.transition",
    "tools"
  ],
  "background_service": {
    "method": "github.reconcile",
    "interval_setting": "github_reconciliation_interval_ms",
    "default_interval_ms": 120000,
    "timeout_ms": 120000
  },
  "ui_contributions": [
    {
      "id": "pull-request",
      "label": "Pull requests",
      "placement": "session.panel",
      "entrypoint": "ui/entry.js",
      "shortcut": "Mod+Shift+P"
    },
    {
      "id": "github-settings",
      "label": "GitHub",
      "placement": "preferences",
      "entrypoint": "ui/settings.js"
    },
    {
      "id": "pull-request-titlebar",
      "label": "GitHub",
      "placement": "titlebar",
      "entrypoint": "ui/titlebar.js"
    },
    {
      "id": "pull-request-meta",
      "label": "Pull requests",
      "placement": "session.meta",
      "entrypoint": "ui/meta.js"
    }
  ],
  "tools": [
    {
      "name": "link_pull_request",
      "description": "Link a GitHub pull request to your PlaneAI session's task, so it shows in the task's pull requests with its state and checks. Call it after you open a pull request that is not on this session's branch, such as one in another repository or another branch of a stack; the session branch's own pull request is tracked without it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The pull request's github.com URL, such as https://github.com/owner/repo/pull/123."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ]
}
