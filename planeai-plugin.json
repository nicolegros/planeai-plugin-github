{
  "schema": "planeai.plugin.v1",
  "id": "github",
  "name": "GitHub",
  "version": "0.0.0",
  "host_api_version": "planeai.plugin-host.v2",
  "source_kind": "local",
  "backend_entrypoints": {
    "macos-arm64": "bin/macos-arm64/planeai-plugin-github",
    "linux-x64": "bin/linux-x64/planeai-plugin-github",
    "windows-x64": "bin/windows-x64/planeai-plugin-github.exe"
  },
  "capabilities": [
    "settings",
    "sessions.read",
    "sessions.repository-context",
    "sessions.prompt",
    "tasks.read",
    "tasks.transition"
  ],
  "background_service": {
    "method": "github.reconcile",
    "interval_setting": "github_reconciliation_interval_ms",
    "default_interval_ms": 120000
  },
  "ui_contributions": [
    {
      "id": "pull-request",
      "label": "Pull Request",
      "placement": "session.panel",
      "entrypoint": "ui/entry.js",
      "shortcut": "Mod+Shift+P"
    },
    {
      "id": "github-settings",
      "label": "GitHub",
      "placement": "preferences",
      "entrypoint": "ui/settings.js"
    },
    {
      "id": "pull-request-titlebar",
      "label": "GitHub",
      "placement": "titlebar",
      "entrypoint": "ui/titlebar.js"
    },
    {
      "id": "pr-check-indicator",
      "label": "GitHub CI",
      "placement": "session.indicator",
      "entrypoint": "ui/indicator.js"
    }
  ]
}
